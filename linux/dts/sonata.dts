
/dts-v1/;

/ {
        compatible = "litex,lowrisc_sonata", "litex,soc";
        model = "lowrisc_sonata";
        #address-cells = <1>;
        #size-cells    = <1>;


        chosen {
            bootargs = "console=liteuart earlycon=liteuart,0xf0001000 root=/dev/mtdblock0 rootfstype=romfs ro init=/sbin/init panic=5 loglevel=4 clk_ignore_unused";
        };

        sys_clk: clock-50000000 {
            compatible = "fixed-clock";
            #clock-cells = <0>;
            clock-frequency  = <50000000>;
        };

        cpus {
            #address-cells = <1>;
            #size-cells    = <0>;
            timebase-frequency = <50000000>;

            CPU0: cpu@0 {
                device_type = "cpu";
                compatible = "riscv";
                riscv,isa-base = "rv32i";
                riscv,isa-extensions = "a", "d", "f", "i", "m", "zicsr", "zifencei";
                mmu-type = "riscv,sv32";
                reg = <0>;
                clock-frequency = <50000000>;
                status = "okay";

                d-cache-size = <8192>;
                d-cache-sets = <64>;
                d-cache-block-size = <64>;

                i-cache-size = <8192>;
                i-cache-sets = <64>;
                i-cache-block-size = <64>;


                tlb-split;
                d-tlb-size = <4>;
                d-tlb-sets = <4>;

                i-tlb-size = <4>;
                i-tlb-sets = <4>;


                L0: interrupt-controller {
                    #address-cells = <0>;
                    #interrupt-cells = <0x00000001>;
                    interrupt-controller;
                    compatible = "riscv,cpu-intc";
                };
            };

            CPU1: cpu@1 {
                device_type = "cpu";
                compatible = "riscv";
                riscv,isa-base = "rv32i";
                riscv,isa-extensions = "a", "d", "f", "i", "m", "zicsr", "zifencei";
                mmu-type = "riscv,sv32";
                reg = <1>;
                clock-frequency = <50000000>;
                status = "okay";

                d-cache-size = <8192>;
                d-cache-sets = <64>;
                d-cache-block-size = <64>;

                i-cache-size = <8192>;
                i-cache-sets = <64>;
                i-cache-block-size = <64>;

                tlb-split;
                d-tlb-size = <4>;
                d-tlb-sets = <4>;

                i-tlb-size = <4>;
                i-tlb-sets = <4>;

                L1: interrupt-controller {
                    #address-cells = <0>;
                    #interrupt-cells = <0x00000001>;
                    interrupt-controller;
                    compatible = "riscv,cpu-intc";
                };
            };

            cpu-map {
                cluster0 {
                    core0 {
                        cpu = <&CPU0>;
                    };
                    core1 {
                        cpu = <&CPU1>;
                    };
                };
            };

        };

        memory: memory@40000000 {
            device_type = "memory";
            reg = <0x40000000 0x7EF000>;
            /* Top 68KB excluded: 4KB PMP guard page at 0x407EF000,
             * then 64KB for OpenSBI RW data at 0x407F0000.
             * OpenSBI runs XIP from flash (.text/.rodata) with only
             * .data/.bss/stacks/heap in RAM (2 harts). */
        };

        vreg_mmc: vreg_mmc {
            compatible = "regulator-fixed";
            regulator-name = "vreg_mmc";
            regulator-min-microvolt = <3300000>;
            regulator-max-microvolt = <3300000>;
            regulator-always-on;
        };

        soc {
            #address-cells = <1>;
            #size-cells    = <1>;
            compatible = "simple-bus";
            interrupt-parent = <&intc0>;
            ranges;

            soc_ctrl0: soc_controller@f0000000 {
                compatible = "litex,soc-controller";
                reg = <0xf0000000 0xc>;
                status = "okay";
            };

            lintc0: clint@f0010000 {
                compatible = "riscv,clint0";
                interrupts-extended = <
                    &L0 3 &L0 7
                    &L1 3 &L1 7>;
                reg = <0xf0010000 0x10000>;
                reg-names = "control";
            };

            intc0: interrupt-controller@f0c00000 {
                compatible = "sifive,fu540-c000-plic", "sifive,plic-1.0.0";
                reg = <0xf0c00000 0x400000>;
                #address-cells = <0>;
                #interrupt-cells = <1>;
                interrupt-controller;
                interrupts-extended = <
                    &L0 11 &L0 9
                    &L1 11 &L1 9>;
                riscv,ndev = <32>;

            };

            liteuart0: serial@f0001000 {
                compatible = "litex,liteuart";
                reg = <0xf0001000 0x100>;
                interrupts = <1>;
                status = "okay";
            };

            flash@2700000 {
                compatible = "mtd-rom";
                reg = <0x02700000 0x900000>;
                bank-width = <1>;
                #address-cells = <1>;
                #size-cells = <1>;
                /* Rootfs starts at flash offset 0x700000, past OpenSBI's
                 * XIP region (0x02600000-0x0264XXXX). */

                rootfs@0 {
                    label = "rootfs";
                    reg = <0x0 0x900000>;
                };
            };

            mmc0: mmc@f0003000 {
                compatible = "litex,mmc";
                reg = <0xf0003000 0x80>;
                clocks = <&sys_clk>;
                bus-width = <0x04>;
                status = "okay";
            };

            spi_eth: spi@80302000 {
                compatible = "lowrisc,opentitan-spi";
                reg = <0x80302000 0x2000>;
                #address-cells = <1>;
                #size-cells = <0>;
                clocks = <&sys_clk>;
                status = "okay";

                ethernet@0 {
                    compatible = "micrel,ks8851";
                    reg = <0>;
                    spi-max-frequency = <12500000>;
                    interrupts = <2>;
                    interrupt-parent = <&intc0>;
                };
            };

            leds: gpio@f0002800 {
                compatible = "litex,gpio";
                reg = <0xf0002800 0x4>;
                gpio-controller;
                #gpio-cells = <2>;
                litex,direction = "out";
                litex,ngpio = <4>;
                status = "okay";
            };

            switches: gpio@f0004000 {
                compatible = "litex,gpio";
                reg = <0xf0004000 0x4>;
                gpio-controller;
                #gpio-cells = <2>;
                litex,direction = "in";
                interrupts = <4>;
                litex,ngpio = <4>;
                status = "okay";
            };

        };

        aliases {
                serial0 = &liteuart0;
        };

};
