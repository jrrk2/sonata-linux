# Architecture - rv32ima, SMP dual-core, no FPU
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
CONFIG_RISCV_ISA_M=y
CONFIG_RISCV_ISA_A=y
CONFIG_RISCV_ISA_C=n
CONFIG_FPU=n
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_EFI=n

# XIP
CONFIG_SPARSEMEM_MANUAL=y
CONFIG_XIP_KERNEL=y
CONFIG_XIP_PHYS_ADDR=0x02000000
CONFIG_XIP_DEFLATED_DATA=y
CONFIG_PHYS_RAM_BASE_FIXED=y
CONFIG_PHYS_RAM_BASE=0x40000000

# MMU
CONFIG_MMU=y

# Device tree
CONFIG_OF=y

# Serial console
CONFIG_TTY=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_SERIAL_LITEUART=y
CONFIG_SERIAL_LITEUART_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y

# Interrupts
CONFIG_SIFIVE_PLIC=y

# CLINT timer
CONFIG_RISCV_TIMER=y
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_LITEX=y

# LiteX SoC
CONFIG_LITEX_SOC_CONTROLLER=y
CONFIG_LITEX_SUBREG_SIZE=4

# Block layer (needed for MTD block + MMC block)
CONFIG_BLOCK=y

# Flash (MTD)
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_PHYSMAP=y
CONFIG_MTD_PHYSMAP_OF=y

# LiteX SPI flash (for transitional boot via spiflash CSR)
CONFIG_MTD_SPI_NOR=y
CONFIG_SPI_FLASH_LITEX=y

# ROMFS on MTD
CONFIG_ROMFS_FS=y
CONFIG_ROMFS_BACKED_BY_MTD=y

# MMC (SD card) - core built-in, LiteX driver as module for testing
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_LITEX=m

# SD card filesystems
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EXT2_FS=y
CONFIG_EXT4_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Swap (partition 3 on SD card)
CONFIG_SWAP=y
CONFIG_ZSWAP=y

# Proc/sys/devtmpfs
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y

# Networking (for ethernet)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=n
CONFIG_PACKET=y
CONFIG_NETDEVICES=y

# GPIO (needed by KS8851 Ethernet driver for gpiod_set_consumer_name)
CONFIG_GPIOLIB=y
CONFIG_GPIO_LITEX=y

# SPI
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_OPENTITAN=y

# KSZ8851SNL SPI ethernet (requires SPI master + GPIOLIB)
CONFIG_KS8851=y
CONFIG_NET_VENDOR_MICREL=y

# Initrd support (keep available but no embedded initramfs)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Command line - extend DTB bootargs with kernel built-in
CONFIG_CMDLINE="clk_ignore_unused"
CONFIG_CMDLINE_EXTEND=y

# Modules (for testing drivers like MMC)
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Misc needed
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_UNIX=y
CONFIG_MULTIUSER=y
CONFIG_SHMEM=y
