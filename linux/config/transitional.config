# Architecture - rv32ima, SMP dual-core, no FPU
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
CONFIG_RISCV_ISA_M=y
CONFIG_RISCV_ISA_A=y
CONFIG_RISCV_ISA_C=n
CONFIG_FPU=n
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_EFI=n

# RAM boot (no XIP)
CONFIG_PHYS_RAM_BASE_FIXED=y
CONFIG_PHYS_RAM_BASE=0x40000000

# MMU
CONFIG_MMU=y

# Device tree
CONFIG_OF=y

# Modules
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Serial console (built-in)
CONFIG_TTY=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_SERIAL_LITEUART=y
CONFIG_SERIAL_LITEUART_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y

# Interrupts (built-in)
CONFIG_SIFIVE_PLIC=y

# CLINT timer (built-in)
CONFIG_RISCV_TIMER=y
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_LITEX=y

# LiteX SoC (built-in)
CONFIG_LITEX_SOC_CONTROLLER=y
CONFIG_LITEX_SUBREG_SIZE=4

# Block layer (built-in)
CONFIG_BLOCK=y

# MMC (built-in, needed to mount root)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_LITEX=y

# Partition table (built-in)
CONFIG_MSDOS_PARTITION=y

# ext2 (built-in, root filesystem)
CONFIG_EXT2_FS=y

# Proc/sys/devtmpfs (built-in)
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y

# ELF loader (built-in)
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Misc (built-in)
CONFIG_UNIX=y
CONFIG_MULTIUSER=y
CONFIG_SWAP=y

# No networking built-in (saves ~1MB+ RAM from hash tables)
CONFIG_NET=n
