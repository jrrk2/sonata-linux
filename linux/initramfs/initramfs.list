# Initramfs file list for gen_init_cpio
# Minimal busybox + networking tools for TFTP-booted kernel

# Directories
dir /dev       755 0 0
dir /proc      755 0 0
dir /sys       755 0 0
dir /tmp       1777 0 0
dir /bin       755 0 0
dir /sbin      755 0 0
dir /lib       755 0 0
dir /etc       755 0 0

# Device nodes
nod /dev/console 600 0 0 c 5 1
nod /dev/null    666 0 0 c 1 3
nod /dev/zero    666 0 0 c 1 5
nod /dev/tty     666 0 0 c 5 0

# Init script
file /init /home/jonathan/sonata-system/linux/initramfs/init 755 0 0

# Busybox + musl libc (from buildroot)
file /bin/busybox /home/jonathan/litex-sonata/buildroot/output/target/bin/busybox 755 0 0
file /lib/libc.so /home/jonathan/litex-sonata/buildroot/output/target/lib/libc.so 755 0 0
slink /lib/ld-musl-riscv32-sf.so.1 libc.so 777 0 0

# Busybox applet symlinks (networking + essentials)
slink /bin/sh       busybox 777 0 0
slink /bin/ash      busybox 777 0 0
slink /bin/cat      busybox 777 0 0
slink /bin/echo     busybox 777 0 0
slink /bin/ls       busybox 777 0 0
slink /bin/mkdir    busybox 777 0 0
slink /bin/mount    busybox 777 0 0
slink /bin/umount   busybox 777 0 0
slink /bin/dmesg    busybox 777 0 0
slink /bin/ps       busybox 777 0 0
slink /bin/grep     busybox 777 0 0
slink /bin/hexdump  busybox 777 0 0
slink /sbin/ifconfig busybox 777 0 0
slink /sbin/route   busybox 777 0 0
slink /sbin/ip      busybox 777 0 0
slink /bin/ping     busybox 777 0 0
